<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">18.0</VisualStudioVersion>
    <VSToolsPath Condition="!Exists('$(VSToolsPath)\Node.js Tools\Microsoft.NodejsToolsV2.targets') and '$(VSINSTALLDIR)' != ''">$(VSINSTALLDIR)MSBuild\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{C2F07A54-6D85-4DF8-B6C9-BB2EB4861A4D}</ProjectGuid>
    <ProjectHome>$(MSBuildProjectDirectory)</ProjectHome>
    <StartupFile>start-frontend.cjs</StartupFile>
    <SearchPath></SearchPath>
    <WorkingDirectory>$(MSBuildProjectDirectory)</WorkingDirectory>
    <OutputPath>$(MSBuildProjectDirectory)</OutputPath>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <ProjectTypeGuids>{3AF33F2E-1136-4D97-BBB7-1795711AC8B8};{349c5851-65df-11da-9384-00065b846f21};{9092AA53-FB77-4645-B42D-1CCCA6BD08BD}</ProjectTypeGuids>
    <NodejsPort>4200</NodejsPort>
    <EnableTypeScript>false</EnableTypeScript>
  </PropertyGroup>
  <Import Project="$(VSToolsPath)\Node.js Tools\Microsoft.NodejsToolsV2.targets" Condition="Exists('$(VSToolsPath)\Node.js Tools\Microsoft.NodejsToolsV2.targets')" />
  <ProjectExtensions>
    <VisualStudio>
      <FlavorProperties GUID="{349c5851-65df-11da-9384-00065b846f21}">
        <WebProjectProperties>
          <UseIIS>False</UseIIS>
          <AutoAssignPort>False</AutoAssignPort>
          <DevelopmentServerPort>4200</DevelopmentServerPort>
          <DevelopmentServerVPath>/</DevelopmentServerVPath>
          <IISUrl>http://localhost:4200/</IISUrl>
          <NTLMAuthentication>False</NTLMAuthentication>
          <StartPageUrl>http://localhost:4200/</StartPageUrl>
          <StartAction>StartPage</StartAction>
